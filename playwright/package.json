{
  "name": "senior-qa-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate:bdd": "bddgen",
    "test": "bddgen && playwright test",
    "test:j01": "bddgen && playwright test --grep @J01",
    "test:j02": "bddgen && playwright test --grep @J02",
    "test:j03": "bddgen && playwright test --grep @J03",
    "test:j04": "bddgen && playwright test --grep @J04",
    "test:j05": "bddgen && playwright test --grep @J05",
    "test:j06": "bddgen && playwright test --grep @J06",
    "test:j07": "bddgen && playwright test --grep @J07",
    "test:j08": "bddgen && playwright test --grep @J08",
    "test:j09": "bddgen && playwright test --grep @J09",
    "test:j10": "bddgen && playwright test --grep @J10",
    "test:smoke": "bddgen && playwright test --grep @smoke",
    "test:regression": "bddgen && playwright test --grep @regression",
    "test:e2e": "bddgen && playwright test --grep @e2e",
    "test:perf": "bddgen && playwright test --grep @perf",
    "report:kpi": "node scripts/kpi.mjs",
    "report:failures": "node scripts/failure-triage.mjs",
    "report:allure": "allure generate test-results/allure-results --output allure-report --clean",
    "report:allure:open": "allure open --host 127.0.0.1 allure-report",
    "test:ui": "bddgen && playwright test --ui",
    "test:headed": "bddgen && playwright test --headed",
    "test:report": "npm run report:failures && npm run report:kpi && playwright show-report playwright-report",
    "install:browsers": "playwright install"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "^24.10.1",
    "allure": "3.22.1",
    "allure-playwright": "3.10.2",
    "dotenv": "^16.4.7",
    "playwright-bdd": "^9.2.1",
    "typescript": "^5.9.3"
  }
}
